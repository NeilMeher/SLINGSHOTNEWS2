# General
NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/slingshot_news
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
CORS_ORIGIN=http://localhost:5173

# News API Keys
REUTERS_API_KEY=your_reuters_key_here
AP_NEWS_API_KEY=your_ap_news_key_here
BBC_API_KEY=your_bbc_key_here
NEWS_API_KEY=your_general_news_api_key_here

# AI & Translation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
