        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Signup",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                                    "var jsonData = pm.response.json();",
                                    "if(jsonData.success) { pm.environment.set(\"accessToken\", jsonData.data.tokens.accessToken); pm.environment.set(\"refreshToken\", jsonData.data.tokens.refreshToken); }"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Password123!\",\n    \"username\": \"testuser\",\n    \"displayName\": \"Test User\",\n    \"dateOfBirth\": \"2000-01-01\",\n    \"region\": \"US\",\n    \"interests\": [\"tech\", \"money\"]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/v1/auth/signup",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "v1",
                                "auth",
                                "signup"
                            ]
                        }
                    },
                    "response": []
                },
